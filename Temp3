function calibInstrumentSet = getCalibInstrumentSet(obj, calibVolSurface, args)
    % G2++ Calibration Setup: Builds the market swaption instruments used
    % by the Bonino calibration pipeline. The function converts each valid
    % volatility quote into a swaption object and its Bachelier market price.
    %
    % INPUTS:
    % obj             | GaussianTwoFactors | scalar : G2++ model
    % calibVolSurface | struct             | scalar : formatted calibration surface
    % args            | struct             | scalar : calibration arguments
    %
    % OUTPUT:
    % calibInstrumentSet | struct | vector : one market instrument per valid surface node

    arguments
        obj (1,1) GaussianTwoFactors
        calibVolSurface (1,1) struct
        args (1,1) struct
    end

    pricers = getCalibrationPricers(obj);

    volMatrix = calibVolSurface.volMatrix;
    [nExpiries, nTenors] = size(volMatrix);

    calibInstrumentSet = struct([]);
    k = 0;

    for i = 1:nExpiries
        for j = 1:nTenors

            marketVol = volMatrix(i,j);

            if ~isfinite(marketVol)
                continue;
            end

            k = k + 1;

            swapStartDate = calibVolSurface.startSwapDatesYr(i,j);
            matSwapDate   = calibVolSurface.matSwapDatesYr(i,j);
            expiry        = calibVolSurface.expiryDates(i);
            tenor         = calibVolSurface.tenors(j);

            irs = copy(args.irs);
            irs.setNotional(args.notional);
            irs.setDates(swapStartDate, matSwapDate);

            [npv, ~, ~] = pricers.swap.IRSVanille(irs, ...
                'measures', true, ...
                'details', true);

            strike = npv.FairSwapRate;

            direction = 'PAY';
            irs.direction = direction;

            swaption = Swaption(irs, ...
                'exerciseDate', calibVolSurface.expiryDatesDt(i), ...
                'strike', strike, ...
                'settleType', args.settleType);

            [~, fixedLegPDates, ~] = irs.fixedLeg01( ...
                calibVolSurface.startSwapDatesYr(i,j));

            fixedLegPDates = fixedLegPDates(:).';

            if numel(fixedLegPDates) < 2
                error("Fixed leg payment dates are not sufficient at node (%d,%d).", i, j);
            end

            paymentDates = fixedLegPDates(2:end);
            paymentDates = paymentDates(:).';

            try
                [marketPrice, ~, ~, bachelierVol] = pricers.bachelier.Swaption( ...
                    swaption, ...
                    'measures', false, ...
                    'vol', marketVol, ...
                    'irsRes', npv);
            catch
                [marketPrice, ~, ~] = pricers.bachelier.Swaption( ...
                    swaption, ...
                    'measures', false, ...
                    'vol', marketVol, ...
                    'irsRes', npv);

                bachelierVol = marketVol;
            end

            if ~isfinite(marketPrice)
                error("Market price is not finite at surface node (%d,%d).", i, j);
            end

            calibInstrumentSet(k).row = i;
            calibInstrumentSet(k).col = j;
            calibInstrumentSet(k).expiry = expiry;
            calibInstrumentSet(k).tenor = tenor;
            calibInstrumentSet(k).swapStartDate = swapStartDate;
            calibInstrumentSet(k).matSwapDate = matSwapDate;
            calibInstrumentSet(k).strike = strike;
            calibInstrumentSet(k).direction = direction;
            calibInstrumentSet(k).swaption = swaption;
            calibInstrumentSet(k).irs = irs;
            calibInstrumentSet(k).npv = npv;
            calibInstrumentSet(k).paymentDates = paymentDates;
            calibInstrumentSet(k).marketVol = marketVol;
            calibInstrumentSet(k).bachelierVol = bachelierVol;
            calibInstrumentSet(k).marketPrice = marketPrice;
            calibInstrumentSet(k).fairSwapRate = npv.FairSwapRate;
        end
    end

    if isempty(calibInstrumentSet)
        error("No valid calibration instrument could be built.");
    end
end
