function h2 = h2Function(obj, h1, By, sigmaYCond)
    % Brigo h2:
    %
    %     h2_i(x) = h1(x) + By_i * Std[Y|X=x]

    arguments
        obj (1,1) GaussianTwoFactors;
        h1 (1,1) double;
        By (:,1) double;
        sigmaYCond (1,1) double {mustBeNonnegative};
    end

    h2 = h1 + By(:) .* sigmaYCond;
end
