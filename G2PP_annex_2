# Annex B.3 - `swaptionPriceFromVol.m`

**Location:** separate file named `swaptionPriceFromVol.m`.

```matlab
function price = swaptionPriceFromVol(F, K, T, annuity, vol, volType, direction, notional)
% Converts quoted normal or Black volatility into a swaption price.

    arguments
        F (1,1) double
        K (1,1) double
        T (1,1) double {mustBeNonnegative}
        annuity (1,1) double {mustBeNonnegative}
        vol (1,1) double {mustBeNonnegative}
        volType (1,:) char {mustBeMember(volType, {'normal','black'})}
        direction (1,:) char {mustBeMember(direction, {'PAY','REC'})} = 'PAY'
        notional (1,1) double = 1.0
    end

    omega = 1;
    if strcmpi(direction, 'REC')
        omega = -1;
    end

    if T == 0 || vol == 0
        intrinsic = max(omega * (F - K), 0);
        price = notional * annuity * intrinsic;
        return;
    end

    sqrtT = sqrt(T);

    switch lower(volType)

        case 'normal'
            std = vol * sqrtT;
            d = (F - K) / std;

            price = notional * annuity * ...
                (omega * (F - K) * normcdf(omega * d) + std * normpdf(d));

        case 'black'
            if F <= 0 || K <= 0
                error('Black volatility requires strictly positive F and K.');
            end

            std = vol * sqrtT;
            d1 = (log(F / K) + 0.5 * std^2) / std;
            d2 = d1 - std;

            price = notional * annuity * ...
                omega * (F * normcdf(omega * d1) - K * normcdf(omega * d2));
    end
end
```

