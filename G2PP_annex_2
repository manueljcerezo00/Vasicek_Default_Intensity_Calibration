function marketPrice = swaptionMarketPriceFromQuote(model, instr)
% Converts a market quote into a market swaption price.

    arguments
        model (1,1) GaussianTwoFactors
        instr (1,1) struct
    end

    [F, A] = getSwaptionForwardAndAnnuityG2PP( ...
        model, instr.expiry, instr.paymentDates);

    if strcmpi(instr.strikeConvention, 'ATM')
        K = F;
    else
        K = instr.fixedStrike;
    end

    switch lower(instr.quoteType)

        case 'price'
            marketPrice = instr.notional * instr.quote;

        case {'normal','black'}
            marketPrice = swaptionPriceFromVol( ...
                F, K, instr.expiry, A, instr.quote, instr.quoteType, ...
                instr.direction, instr.notional);

        otherwise
            error("Unsupported quote type.");
    end
end
