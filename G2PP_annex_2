```matlab
function [forwardSwapRate, annuity, delta, P0T0, P0Ti] = ...
    getSwaptionForwardAndAnnuityG2PP(model, expiry, paymentDates)
% Computes single-curve forward swap rate and annuity.

    arguments
        model (1,1) GaussianTwoFactors
        expiry (1,1) double
        paymentDates (1,:) double
    end

    paymentDates = paymentDates(:);

    zc = model.getInitialMarketZC([expiry, paymentDates.']);
    zc = zc(:);

    P0T0 = zc(1);
    P0Ti = zc(2:end);

    delta = diff([expiry; paymentDates]);

    annuity = sum(delta .* P0Ti);

    forwardSwapRate = (P0T0 - P0Ti(end)) / annuity;
end
```

