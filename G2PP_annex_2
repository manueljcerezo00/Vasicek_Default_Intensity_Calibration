# Annex A.10 - `brigoSwaptionIntegrand`

**Location:** inside `GaussianTwoFactors.m`, inside `methods`.

```matlab
function output = brigoSwaptionIntegrand(obj, z, omega, coeffs, A0Ti, Bx, By, gaussianState)
    % Brigo G2++ swaption integrand after change of variable:
    %
    %     x = muX + sigmaX*z,     z ~ N(0,1)
    %
    % Original:
    %
    %     integral G(x) f_X(x) dx
    %
    % After change of variable:
    %
    %     integral G(muX + sigmaX*z) phi(z) dz
    %
    % No extra sigmaX multiplier appears.

    arguments
        obj (1,1) GaussianTwoFactors;
        z double;
        omega (1,1) double {mustBeMember(omega, [-1, 1])};
        coeffs (:,1) double;
        A0Ti (:,1) double;
        Bx (:,1) double;
        By (:,1) double;
        gaussianState (1,1) struct;
    end

    z = z(:).';
    output = zeros(size(z));

    coeffs = coeffs(:);
    A0Ti = A0Ti(:);
    Bx = Bx(:);
    By = By(:);

    muX = gaussianState.muX;
    muY = gaussianState.muY;
    varX = gaussianState.varX;
    varY = gaussianState.varY;
    covXY = gaussianState.covXY;

    if varX <= 0
        error("varX must be strictly positive.");
    end

    sigmaX = sqrt(varX);

    % Conditional variance of Y | X=x. Constant with respect to x.
    varYCond = varY - (covXY^2 / varX);
    varYCond = max(varYCond, 0);
    sigmaYCond = sqrt(varYCond);

    for j = 1:numel(z)

        % Change of variable: x = muX + sigmaX*z
        xVal = muX + sigmaX * z(j);

        % lambda_i(x)
        lambda = obj.getLambda(coeffs, A0Ti, Bx, xVal);

        % Solve boundary yBar(x)
        yBar = obj.yBarSolverFromLambda(lambda, By);

        if ~isfinite(yBar)
            output(j) = NaN;
            continue;
        end

        % Conditional mean E[Y | X = x]
        muYCond = muY + (covXY / varX) * (xVal - muX);

        if sigmaYCond <= 0
            basketVal = sum(lambda .* exp(-By .* muYCond));

            if omega == 1
                condPayoff = max(1 - basketVal, 0);
            else
                condPayoff = max(basketVal - 1, 0);
            end

            output(j) = condPayoff * normpdf(z(j));
            continue;
        end

        % Brigo objects
        h1 = obj.h1Function(yBar, muYCond, sigmaYCond);
        h2 = obj.h2Function(h1, By, sigmaYCond);
        kappa = obj.kappaFunction(By, muYCond, varYCond);

        % Brigo bracket
        bracket = normcdf(-omega .* h1) ...
                - sum(lambda .* exp(kappa) .* normcdf(-omega .* h2));

        % Standard-normal integration density
        output(j) = omega .* bracket .* normpdf(z(j));
    end
end
```

