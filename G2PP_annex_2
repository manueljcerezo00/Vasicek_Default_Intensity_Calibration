function value = getYBarValue(obj, y, lambda, By)
    % Scalar equation for yBar:
    %
    %     f(y) = 1 - sum_i lambda_i(x) * exp(-By_i * y)

    arguments
        obj (1,1) GaussianTwoFactors;
        y (1,1) double;
        lambda (:,1) double;
        By (:,1) double;
    end

    value = 1 - sum(lambda .* exp(-By .* y));
end
```

