```matlab
function thetaRaw = g2ppInverseTransformBrigo5(a, b, sigma, eta, rho)
% Maps admissible five-parameter G2++ parameters to unconstrained variables.

    arguments
        a (1,1) double {mustBePositive}
        b (1,1) double {mustBePositive}
        sigma (1,1) double {mustBePositive}
        eta (1,1) double {mustBePositive}
        rho (1,1) double
    end

    if abs(rho) >= 1
        error("rho must satisfy abs(rho) < 1.");
    end

    thetaRaw = [
        log(a);
        log(b);
        log(sigma);
        log(eta);
        atanh(rho)
    ];
end
```

