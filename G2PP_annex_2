# Annex B.4 - `swaptionImpliedVolFromPrice.m`

**Location:** separate file named `swaptionImpliedVolFromPrice.m`.

```matlab
function impVol = swaptionImpliedVolFromPrice(price, F, K, T, annuity, volType, direction, notional)
% Computes implied normal or Black volatility from a swaption price.

    arguments
        price (1,1) double {mustBeNonnegative}
        F (1,1) double
        K (1,1) double
        T (1,1) double {mustBeNonnegative}
        annuity (1,1) double {mustBeNonnegative}
        volType (1,:) char {mustBeMember(volType, {'normal','black'})}
        direction (1,:) char {mustBeMember(direction, {'PAY','REC'})} = 'PAY'
        notional (1,1) double = 1.0
    end

    omega = 1;
    if strcmpi(direction, 'REC')
        omega = -1;
    end

    intrinsic = notional * annuity * max(omega * (F - K), 0);

    if price < intrinsic - 1e-12
        impVol = NaN;
        return;
    end

    if abs(price - intrinsic) < 1e-14
        impVol = 0;
        return;
    end

    objFun = @(v) swaptionPriceFromVol( ...
        F, K, T, annuity, v, volType, direction, notional) - price;

    switch lower(volType)

        case 'normal'
            volLow = 1e-10;
            volHigh = 5.0;

        case 'black'
            if F <= 0 || K <= 0
                impVol = NaN;
                return;
            end
            volLow = 1e-10;
            volHigh = 5.0;
    end

    while objFun(volHigh) < 0
        volHigh = 2 * volHigh;

        if volHigh > 100
            impVol = NaN;
            return;
        end
    end

    impVol = fzero(objFun, [volLow, volHigh]);
end
```

