function [residuals, diagnostics] = g2ppCalibrationResiduals(thetaRaw, model, calibSet, args)
% Residual vector for five-parameter constant-vol G2++ calibration.

    arguments
        thetaRaw (5,1) double
        model (1,1) GaussianTwoFactors
        calibSet (1,:) struct
        args.objectiveType (1,:) char {mustBeMember(args.objectiveType, {'price','normalizedPrice','vol'})} = 'normalizedPrice'
        args.volTypeForDiagnostics (1,:) char {mustBeMember(args.volTypeForDiagnostics, {'normal','black'})} = 'normal'
        args.badValuePenalty (1,1) double = 1e6
    end

    params = g2ppApplyTransformBrigo5(model, thetaRaw);

    n = numel(calibSet);
    residuals = zeros(n,1);

    diagnostics.modelPrice = NaN(n,1);
    diagnostics.marketPrice = NaN(n,1);
    diagnostics.modelVol = NaN(n,1);
    diagnostics.marketVol = NaN(n,1);
    diagnostics.strike = NaN(n,1);
    diagnostics.forward = NaN(n,1);
    diagnostics.annuity = NaN(n,1);
    diagnostics.expiry = NaN(n,1);
    diagnostics.tenor = NaN(n,1);
    diagnostics.params = params;

    for k = 1:n
        instr = calibSet(k);

        try
            K = getCalibrationStrikeG2PP(model, instr);

            [F, A] = getSwaptionForwardAndAnnuityG2PP( ...
                model, instr.expiry, instr.paymentDates);

            marketPrice = swaptionMarketPriceFromQuote(model, instr);

            modelPrice = model.priceSwaptionG2PP( ...
                K, instr.expiry, instr.paymentDates, ...
                'direction', instr.direction, ...
                'notional', instr.notional);

            diagnostics.modelPrice(k) = modelPrice;
            diagnostics.marketPrice(k) = marketPrice;
            diagnostics.strike(k) = K;
            diagnostics.forward(k) = F;
            diagnostics.annuity(k) = A;
            diagnostics.expiry(k) = instr.expiry;

            if isfield(instr, 'tenor')
                diagnostics.tenor(k) = instr.tenor;
            end

            if isfield(instr, 'quote') && any(strcmpi(instr.quoteType, {'normal','black'}))
                diagnostics.marketVol(k) = instr.quote;
            end

            switch args.objectiveType

                case 'price'
                    residuals(k) = sqrt(instr.weight) * (modelPrice - marketPrice);

                case 'normalizedPrice'
                    scale = max(instr.notional * A, 1e-12);
                    residuals(k) = sqrt(instr.weight) * (modelPrice - marketPrice) / scale;

                case 'vol'
                    modelVol = swaptionImpliedVolFromPrice( ...
                        modelPrice, F, K, instr.expiry, A, ...
                        args.volTypeForDiagnostics, instr.direction, instr.notional);

                    diagnostics.modelVol(k) = modelVol;

                    if isfield(instr, 'quote') && strcmpi(instr.quoteType, args.volTypeForDiagnostics)
                        marketVol = instr.quote;
                    else
                        marketVol = swaptionImpliedVolFromPrice( ...
                            marketPrice, F, K, instr.expiry, A, ...
                            args.volTypeForDiagnostics, instr.direction, instr.notional);
                    end

                    diagnostics.marketVol(k) = marketVol;

                    if ~isfinite(modelVol) || ~isfinite(marketVol)
                        residuals(k) = args.badValuePenalty;
                    else
                        residuals(k) = sqrt(instr.weight) * (modelVol - marketVol);
                    end
            end

            if ~isfinite(residuals(k))
                residuals(k) = args.badValuePenalty;
            end

        catch
            residuals(k) = args.badValuePenalty;
        end
    end
end
