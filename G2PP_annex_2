# Annex B.10 - `calibrateG2PPToSwaptionSet.m`

**Location:** separate file named `calibrateG2PPToSwaptionSet.m`.

```matlab
function result = calibrateG2PPToSwaptionSet(model, calibSet, theta0Raw, args)
% Calibrates five-parameter constant-vol G2++ model to a swaption set.

    arguments
        model (1,1) GaussianTwoFactors
        calibSet (1,:) struct
        theta0Raw (5,1) double
        args.objectiveType (1,:) char {mustBeMember(args.objectiveType, {'price','normalizedPrice','vol'})} = 'normalizedPrice'
        args.volTypeForDiagnostics (1,:) char {mustBeMember(args.volTypeForDiagnostics, {'normal','black'})} = 'normal'
        args.maxIterations (1,1) double = 200
        args.display (1,:) char = 'iter'
        args.useLsqnonlin (1,1) logical = true
    end

    residualFun = @(theta) g2ppCalibrationResiduals( ...
        theta, model, calibSet, ...
        'objectiveType', args.objectiveType, ...
        'volTypeForDiagnostics', args.volTypeForDiagnostics);

    if args.useLsqnonlin

        opts = optimoptions('lsqnonlin', ...
            'Display', args.display, ...
            'MaxIterations', args.maxIterations, ...
            'StepTolerance', 1e-8, ...
            'FunctionTolerance', 1e-8);

        [thetaStar, resnorm, residuals, exitflag, output] = ...
            lsqnonlin(residualFun, theta0Raw, [], [], opts);

    else

        objFun = @(theta) sum(residualFun(theta).^2);

        opts = optimset( ...
            'Display', args.display, ...
            'MaxIter', args.maxIterations);

        [thetaStar, resnorm, exitflag, output] = ...
            fminsearch(objFun, theta0Raw, opts);

        residuals = residualFun(thetaStar);
    end

    params = g2ppApplyTransformBrigo5(model, thetaStar);

    [finalResiduals, diagnostics] = g2ppCalibrationResiduals( ...
        thetaStar, model, calibSet, ...
        'objectiveType', args.objectiveType, ...
        'volTypeForDiagnostics', args.volTypeForDiagnostics);

    result.thetaRaw = thetaStar;
    result.params = params;
    result.resnorm = resnorm;
    result.residuals = residuals;
    result.finalResiduals = finalResiduals;
    result.exitflag = exitflag;
    result.output = output;
    result.diagnostics = diagnostics;

    result.rmse = sqrt(mean(finalResiduals.^2));
    result.maxAbsError = max(abs(finalResiduals));
end
